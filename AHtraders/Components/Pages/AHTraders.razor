        }

        .about-story {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .feature-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .feature-image-wrap {
            height: 250px;
        }

        .feature-card-body h4 {
            font-size: 24px;
        }

        .feature-card-body p {
            font-size: 16px;
        }
    }

    @@media (max-width: 768px) {
        .topbar,
        .section-shell {
            padding-left: 20px;
            padding-right: 20px;
        }

        .hero-content {
            padding-left: 20px;
            padding-right: 20px;
