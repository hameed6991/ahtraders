@page "/ahtraders"
@inject IJSRuntime JS

<PageTitle>AH Traders</PageTitle>

<div class="ah-wrapper">

    <!-- HERO SECTION -->
    <section class="hero-section" id="home">
        <div class="hero-overlay"></div>

        <header class="topbar">
            <div class="brand-block">
                <h1>AH TRADERS</h1>
                <p>EXQUISITE RICE EXPORTERS</p>
            </div>

            <nav class="nav-menu">
                <a href="javascript:void(0)" @onclick='@(() => ScrollToSection("home"))'>HOME</a>
                <a href="javascript:void(0)" @onclick='@(() => ScrollToSection("about"))'>ABOUT US</a>
                <a href="javascript:void(0)" @onclick='@(() => ScrollToSection("rice"))'>OUR RICE</a>
                <a href="javascript:void(0)" @onclick='@(() => ScrollToSection("contact"))'>CONTACT</a>
            </nav>
        </header>

        <div class="hero-content">
            <div class="hero-image-wrap">
                <div class="hero-image-card">
                    <img src="/Images/rice-bowl.png" alt="Rice Bowl" class="hero-image" />
                </div>
            </div>

            <div class="hero-text-wrap">
                <div class="hero-badge">Premium Rice Export Company</div>

                <h2>
                    The Finest Rice
                    <span>From Our Fields</span>
                    to the World
                </h2>

                <p>
                    AH Traders delivers premium rice varieties with luxury presentation,
                    trusted quality, and export-grade standards crafted for modern buyers.
                </p>

                <div class="hero-actions">
                    <button type="button" class="btn-gold" @onclick='@(() => ScrollToSection("rice"))'>DISCOVER MORE</button>
                    <button type="button" class="btn-outline" @onclick='@(() => ScrollToSection("contact"))'>CONTACT US</button>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="about-section section-shell" id="about">
        <div class="section-heading center">
            <span class="section-mini">About AH Traders</span>
            <h3>Crafting Excellence in Every Grain</h3>
            <p>
                AH Traders stands as a symbol of trust, quality, and global excellence
                in the rice export industry.
            </p>
        </div>

        <div class="about-story">
            <div class="about-text">
                <h4>Our Journey</h4>

                <p>
                    Founded with a vision to deliver the finest rice across the globe,
                    AH Traders has grown into a trusted export partner known for quality,
                    consistency, and integrity.
                </p>

                <p>
                    We combine traditional sourcing values with modern export standards,
                    ensuring every grain meets international expectations and customer trust.
                </p>

                <p>
                    From local farming roots to wider market reach, our commitment remains the same —
                    to provide premium rice with dependable service and long-term business value.
                </p>
            </div>

            <div class="about-image-card">
                <img src="/Images/premium-quality.png" alt="About AH Traders" />
            </div>
        </div>

        <div class="about-grid">
            <div class="about-card">
                <h4>Premium Sourcing</h4>
                <p>
                    Carefully selected rice varieties ensuring purity,
                    taste, and superior quality in every grain.
                </p>
            </div>

            <div class="about-card">
                <h4>Global Export</h4>
                <p>
                    Delivering products across international markets with
                    reliable logistics and export-ready standards.
                </p>
            </div>

            <div class="about-card">
                <h4>Trusted Partner</h4>
                <p>
                    Strong client relationships built on transparency,
                    commitment, and customer satisfaction.
                </p>
            </div>
        </div>
    </section>

    <!-- RICE SECTION -->
    <section class="rice-section section-shell" id="rice">
        <div class="section-heading center">
            <span class="section-mini">Our Rice Varieties</span>
            <h3>Curated Selection for Premium Buyers</h3>
        </div>

        <div class="rice-grid">
            <div class="rice-card">
                <div class="rice-image-wrap">
                    <img src="/Images/kabuli-basmati.png" alt="Kabuli Basmati" />
                </div>
                <div class="rice-card-body">
                    <h4>KABULI BASMATI</h4>
                    <div class="price-pill">₹90/kg</div>
                </div>
            </div>

            <div class="rice-card">
                <div class="rice-image-wrap">
                    <img src="/Images/sona-masoori.png" alt="Sona Masoori" />
                </div>
                <div class="rice-card-body">
                    <h4>SONA MASOORI</h4>
                    <div class="price-pill">₹65/kg</div>
                </div>
            </div>

            <div class="rice-card">
                <div class="rice-image-wrap">
                    <img src="/Images/idli-rice.png" alt="Idli Rice" />
                </div>
                <div class="rice-card-body">
                    <h4>IDLI RICE</h4>
                    <div class="price-pill">₹50/kg</div>
                </div>
            </div>

            <div class="rice-card">
                <div class="rice-image-wrap">
                    <img src="/Images/matta-rice.png" alt="Matta Rice" />
                </div>
                <div class="rice-card-body">
                    <h4>MATTA RICE</h4>
                    <div class="price-pill">₹55/kg</div>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURE SECTION -->
    <section class="feature-section section-shell">
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-image-wrap">
                    <img src="/Images/premium-quality.png" alt="Premium Quality" />
                </div>
                <div class="feature-card-body">
                    <h4>PREMIUM QUALITY</h4>
                    <p>Sourcing the Best, Delivering the Finest</p>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-image-wrap">
                    <img src="/Images/global-reach.png" alt="Global Reach" />
                </div>
                <div class="feature-card-body">
                    <h4>GLOBAL REACH</h4>
                    <p>Exporting to Over 30+ Countries</p>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-image-wrap">
                    <img src="/Images/timeless-tradition.png" alt="Timeless Tradition" />
                </div>
                <div class="feature-card-body">
                    <h4>TIMELESS TRADITION</h4>
                    <p>Heritage of Excellence in Every Grain</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT SECTION -->
    <section class="contact-section section-shell" id="contact">
        <div class="contact-card">
            <span class="section-mini">Contact Us</span>
            <h3>Let’s Talk Business</h3>

            <div class="contact-row">
                <a href="tel:9944588923">📞 9944588923</a>
                <span class="divider">|</span>
                <a href="mailto:ahhtraders13@gmail.com">✉ ahhtraders13@gmail.com</a>
            </div>

            <div class="address-block">
                📍 17 A, Corpender Street,<br />
                Adiramapattinam, Thanjavur,<br />
                Tamil Nadu, 614701
            </div>
        </div>
    </section>

</div>

<script>
    window.scrollToSectionById = (sectionId) => {
        const element = document.getElementById(sectionId);
        if (element) {
            element.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    };
</script>

@code {
    private async Task ScrollToSection(string sectionId)
    {
        await JS.InvokeVoidAsync("scrollToSectionById", sectionId);
    }
}

<style>
    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background: #120804;
        color: #f3ddb4;
        font-family: Georgia, "Times New Roman", serif;
    }

    * {
        box-sizing: border-box;
    }

    .ah-wrapper {
        min-height: 100vh;
        overflow-x: hidden;
        background: linear-gradient(rgba(17, 8, 4, 0.74), rgba(17, 8, 4, 0.92)), url('/Images/site-bg.png') center/cover no-repeat fixed;
    }

    .hero-section {
        position: relative;
        min-height: 100vh;
        border-bottom: 1px solid rgba(212, 160, 85, 0.18);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top center, rgba(219, 162, 87, 0.10), transparent 28%), linear-gradient(to bottom, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.20));
        pointer-events: none;
    }

    .topbar,
    .hero-content,
    .section-shell {
        position: relative;
        z-index: 2;
    }

    .topbar {
        max-width: 1400px;
        margin: 0 auto;
        padding: 34px 40px 22px;
        text-align: center;
    }

    .brand-block h1 {
        margin: 0;
        color: #d8a055;
        font-size: 86px;
        font-weight: 600;
        letter-spacing: 3px;
        line-height: 1;
        text-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .brand-block p {
        margin: 14px 0 0;
        color: #ebcb8c;
        letter-spacing: 5px;
        font-size: 20px;
    }

    .nav-menu {
        margin-top: 28px;
        padding: 18px 0;
        display: flex;
        justify-content: center;
        gap: 46px;
        border-top: 1px solid rgba(212, 160, 85, 0.20);
        border-bottom: 1px solid rgba(212, 160, 85, 0.20);
        flex-wrap: wrap;
    }

        .nav-menu a {
            color: #e7c98d;
            text-decoration: none;
            font-size: 15px;
            letter-spacing: 2px;
            transition: all 0.25s ease;
            cursor: pointer;
        }

            .nav-menu a:hover {
                color: #ffe2a6;
                text-shadow: 0 0 12px rgba(255, 207, 130, 0.35);
            }

    .hero-content {
        max-width: 1400px;
        margin: 0 auto;
        min-height: calc(100vh - 220px);
        display: grid;
        grid-template-columns: 1.02fr 0.98fr;
        align-items: center;
        gap: 40px;
        padding: 40px 40px 80px;
    }

    .hero-image-wrap {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .hero-image-card {
        width: 100%;
        max-width: 560px;
        height: 620px;
        padding: 16px;
        border-radius: 32px;
        background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01));
        border: 1px solid rgba(212, 160, 85, 0.18);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.42);
        backdrop-filter: blur(6px);
        overflow: hidden;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        display: block;
        border-radius: 24px;
        object-fit: cover;
        object-position: center;
    }

    .hero-text-wrap {
        text-align: left;
        max-width: 620px;
        margin-left: auto;
    }

    .hero-badge {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 999px;
        border: 1px solid rgba(212, 160, 85, 0.22);
        background: rgba(255,255,255,0.04);
        color: #efcf92;
        font-size: 12px;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .hero-text-wrap h2 {
        margin: 0;
        color: #fff0cb;
        font-size: 92px;
        line-height: 0.96;
        font-weight: 500;
        text-shadow: 0 8px 22px rgba(0,0,0,0.35);
    }

        .hero-text-wrap h2 span {
            display: block;
            color: #e3b46a;
            font-size: 74px;
            margin: 14px 0;
        }

    .hero-text-wrap p {
        margin: 28px 0 0;
        color: #ead5aa;
        font-size: 21px;
        line-height: 1.8;
        max-width: 560px;
    }

    .hero-actions {
        margin-top: 34px;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .btn-gold,
    .btn-outline {
        padding: 18px 30px;
        border-radius: 999px;
        font-size: 15px;
        letter-spacing: 2px;
        transition: all 0.25s ease;
        cursor: pointer;
        border: none;
        font-family: inherit;
    }

    .btn-gold {
        color: #fff3d6;
        border: 1px solid rgba(212, 160, 85, 0.35);
        background: linear-gradient(135deg, #6f3e12, #d49a48);
        box-shadow: 0 14px 32px rgba(140, 85, 25, 0.35);
    }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 40px rgba(140, 85, 25, 0.45);
        }

    .btn-outline {
        color: #f2ddb0;
        border: 1px solid rgba(255, 225, 173, 0.22);
        background: rgba(255,255,255,0.04);
    }

        .btn-outline:hover {
            background: rgba(255,255,255,0.08);
        }

    .section-shell {
        max-width: 1400px;
        margin: 0 auto;
        padding: 100px 40px 20px;
    }

    .section-heading {
        max-width: 920px;
        margin: 0 auto 36px;
    }

        .section-heading.center {
            text-align: center;
        }

    .section-mini {
        display: inline-block;
        color: #d39a4b;
        font-size: 13px;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .section-heading h3,
    .contact-card h3 {
        margin: 0;
        color: #fff0cd;
        font-size: 58px;
        font-weight: 500;
        line-height: 1.1;
    }

    .section-heading p {
        margin: 20px 0 0;
        color: #ead5aa;
        font-size: 19px;
        line-height: 1.8;
    }

    .about-story {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 40px;
        margin-top: 50px;
        align-items: center;
    }

    .about-text h4 {
        margin: 0 0 14px;
        font-size: 38px;
        color: #efcd8c;
    }

    .about-text p {
        margin: 12px 0;
        font-size: 18px;
        line-height: 1.8;
        color: #e6d0a1;
    }

    .about-image-card {
        height: 420px;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(212,160,85,0.2);
        box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    }

        .about-image-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .about-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 50px;
    }

    .about-card {
        padding: 28px;
        border-radius: 24px;
        background: rgba(255,255,255,0.035);
        border: 1px solid rgba(212, 160, 85, 0.15);
        box-shadow: 0 18px 44px rgba(0,0,0,0.24);
    }

        .about-card h4 {
            margin: 0 0 12px;
            color: #efcd8c;
            font-size: 30px;
            font-weight: 500;
        }

        .about-card p {
            margin: 0;
            color: #e6d0a1;
            font-size: 17px;
            line-height: 1.7;
        }

    .rice-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-top: 40px;
    }

    .rice-card {
        overflow: hidden;
        border-radius: 28px;
        background: rgba(20, 10, 5, 0.84);
        border: 1px solid rgba(220, 163, 90, 0.18);
        box-shadow: 0 24px 58px rgba(0,0,0,0.30);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .rice-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 30px 68px rgba(0,0,0,0.38);
        }

    .rice-image-wrap {
        overflow: hidden;
    }

    .rice-card img {
        width: 100%;
        height: 300px;
        display: block;
        object-fit: cover;
        transition: transform 0.35s ease;
    }

    .rice-card:hover img {
        transform: scale(1.04);
    }

    .rice-card-body {
        padding: 22px 18px 26px;
        text-align: center;
    }

        .rice-card-body h4 {
            margin: 0;
            color: #f0cf91;
            font-size: 30px;
            font-weight: 500;
            line-height: 1.2;
        }

    .price-pill {
        display: inline-block;
        margin-top: 14px;
        padding: 10px 18px;
        border-radius: 999px;
        background: rgba(212, 160, 85, 0.10);
        border: 1px solid rgba(212, 160, 85, 0.20);
        color: #fff0ca;
        font-size: 21px;
        font-weight: 700;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        align-items: stretch;
    }

    .feature-card {
        overflow: hidden;
        border-radius: 28px;
        background: rgba(20, 10, 5, 0.84);
        border: 1px solid rgba(220, 163, 90, 0.18);
