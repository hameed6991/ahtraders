        }

        .brand-block p {
            font-size: 14px;
            letter-spacing: 3px;
        }

        .nav-menu {
            gap: 18px;
        }

        .hero-text-wrap h2 {
            font-size: 48px;
        }

            .hero-text-wrap h2 span {
                font-size: 38px;
            }

        .hero-text-wrap p {
            font-size: 17px;
        }

        .section-heading h3,
        .contact-card h3 {
            font-size: 38px;
        }

        .rice-grid {
            grid-template-columns: 1fr;
        }

        .feature-grid {
            grid-template-columns: 1fr;
        }

        .feature-image-wrap {
            height: 300px;
        }

        .contact-row {
            flex-direction: column;
            gap: 10px;
        }

        .divider {
            display: none;
        }

        .contact-row a {
            font-size: 18px;
        }

        .address-block {
            font-size: 16px;
        }
    }
</style>