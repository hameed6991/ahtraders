        }

            .contact-row a:hover {
                color: #ffe2a7;
            }

    .divider {
        color: rgba(240, 205, 140, 0.5);
        font-size: 24px;
    }

    .address-block {
        margin-top: 26px;
        font-size: 18px;
        color: #e8d3a6;
        line-height: 1.8;
        text-align: center;
        border-top: 1px solid rgba(212, 160, 85, 0.2);
        padding-top: 20px;
    }

