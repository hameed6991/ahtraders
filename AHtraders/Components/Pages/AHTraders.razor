    }

    .contact-card {
        text-align: center;
        padding: 42px 28px;
        border-radius: 30px;
        background: rgba(255,255,255,0.035);
        border: 1px solid rgba(212, 160, 85, 0.16);
        box-shadow: 0 18px 44px rgba(0,0,0,0.24);
    }

    .contact-row {
        margin-top: 28px;
        display: flex;
